{
  "name": "dinks",
  "private": true,
  "workspaces": ["web", "mobile", "packages/*"],
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "scripts": {
    "build:web": "npm run build --workspace=@dinks/web",
